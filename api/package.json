{
  "name": "@lockedin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:coverage",
    "test:clean-reports": "node -e \"for (const name of ['tests.json', 'integration-pass-rate.json']) require('node:fs').rmSync('test-results/' + name, { force: true })\"",
    "test:coverage": "npm run test:clean-reports && tsc --noEmit && vitest run --coverage",
    "test:integration": "npm run test:clean-reports && tsc --noEmit && vitest run test/integration",
    "integration:pass-rate": "node scripts/integration-pass-rate.mjs",
    "lint": "eslint .",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "4.1.12"
  }
}
