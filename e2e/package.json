{
  "name": "@lockedin/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright UI tests and the scheduled heartbeat test.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:heartbeat": "node scripts/heartbeat-summary.mjs --clean && playwright test --config=playwright.heartbeat.config.ts",
    "test:heartbeat:validation": "node --test scripts/heartbeat-summary.test.mjs && playwright test --config=playwright.heartbeat-validation.config.ts",
    "heartbeat:summary": "node scripts/heartbeat-summary.mjs",
    "pass-rate": "node scripts/pass-rate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43"
  }
}
