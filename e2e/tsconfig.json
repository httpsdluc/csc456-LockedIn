{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "playwright.heartbeat.config.ts", "playwright.heartbeat-validation.config.ts", "tests", "heartbeat", "heartbeat-validation"]
}
